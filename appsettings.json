{
  "App": {
    "Id": "WatchTowerService",
    "SourceDir": ".\\payload",
    "TargetDir": "C:\\Services\\WatchTowerService",
    "CleanTarget": true,
    "Preserve": [ "logs\\*", "config\\*.json" ],
    "StopProcesses": [ "WatchTowerService.exe" ],
    "PostInstallRun": [ ],
    "PostUninstallDelete": [ "logs\\*" ]
  },
  "Services": [
    {
      "Name": "watch-tower",
      "DisplayName": "watch-tower",
      "Description": "Watch and restart Windows services per appsettings.json",
      "Exe": "WatchTowerService.exe",
      "StartType": "auto",              // auto | demand | disabled
      "Account": "LocalSystem",         // LocalSystem | .\User | DOMAIN\User
      "Password": null,
      "FailureActions": "reset= 86400 actions= restart/60000/restart/60000/restart/60000"
    }
  ]
}
